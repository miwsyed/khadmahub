{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MyAppDb.db"
  },
  "Jwt": {
    "Key": "this-is-a-test-key-which-must-be-at-least-32-bytes-long",
    "Issuer": "MyApp",
    "Audience": "MyApp",
    "AccessTokenLifetimeMinutes": 15
  },
  "Authentication": {
    "Lockout": {
      "FailedAttemptsBeforeLockout": 5,
      "LockoutMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 7,
      "CookieName": "myapp_refresh_token"
    }
  },
  "AdminUser": {
    "Username": "admin",
    "Password": "Admin@123"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  }
}
